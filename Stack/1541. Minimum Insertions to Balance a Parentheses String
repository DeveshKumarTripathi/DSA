
class Solution {
    public int minInsertions(String s) {
        int n = s.length();
        Stack<Character> st = new Stack<>();
        
        int ans = 0;

        for (int i = 0; i < n; i++) {
            if (s.charAt(i) == '(') {
                st.push('(');
            } else {
                if (i + 1 < n && s.charAt(i + 1) == ')') {
                    i++;
                } else {
                    ans++;
                }

                if (!st.isEmpty()) {
                    st.pop();
                } else {
                    ans++;
                }
            }
        }
        ans += st.size() * 2;
        return ans;
    }
}
