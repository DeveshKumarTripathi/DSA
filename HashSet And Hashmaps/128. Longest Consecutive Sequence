class Solution {
    public int longestConsecutive(int[] nums) {
        int n = nums.length;
        if(n==0)return 0;
        TreeSet<Integer> set = new TreeSet<>();

        for (int i = 0; i < n; i++) {
            set.add(nums[i]);
        }
        int count= 1;
        int max = 1;
        int prev = set.first();

        for (int x : set) {
            if (x == prev + 1) {
                count++;
            } else {
                count = 1;
            }
            max = Math.max(max, count);
            prev = x;
        }
        return max;
    }
}
