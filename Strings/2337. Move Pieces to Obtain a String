class Solution {
    public boolean canChange(String s1, String s2) {
        if (s1.length() != s2.length()) {
			return false;
		}
		int i = 0, j = 0;
		int n = s1.length();
		
		while (i <= n && j <= n) {
			while (i < n && s1.charAt(i) == '_') {
				i++;
			}
			while (j < n && s2.charAt(j) == '_') {
				j++;
			}
			if (i == n || j == n) {
				return i == n && j == n;
			}
			if (s1.charAt(i) != s2.charAt(j)) {
				return false;
			}
			if (s1.charAt(i) == 'L' && i < j) {
				return false;
			}
			if (s1.charAt(i) == 'R' && i > j) {
				return false;
			}
			i++;
			j++;
		}
		return true;
    }
}
