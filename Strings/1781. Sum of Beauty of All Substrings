class Solution {
    public int beautySum(String s) {
        int n = s.length();
        int ans = 0;

        for(int i = 0; i < n; i++){
            int[] freq = new int[26];

            for(int j = i; j < n; j++){
                freq[s.charAt(j) - 'a']++;

                int most = 0;
                int least = Integer.MAX_VALUE;

                for(int k = 0; k < 26; k++){
                    if(freq[k] > 0){
                        most = Math.max(most, freq[k]);
                        least = Math.min(least, freq[k]);
                    }
                }
                ans += most - least;
            }
        }
        return ans;
    }
}
