class Solution {
    public List<String> generateParenthesis(int n) {
        List<String> ans = new ArrayList<>();
        solve(n, 0, 0, ans, "");
        return ans;
    }
    public void solve(int n, int open, int close, List<String> ans, String str){
        if(str.length() == 2*n){
            ans.add(str);
            return;
        }
        if(open < n){
            solve(n, open + 1, close, ans, str + "(");
        }
        if(close < open){
            solve(n, open, close + 1, ans, str + ")");
        }

    }
}
