class Solution {
    public int countRotations(String s, int k) {
        int n = s.length();
        int ans =0;

        for(int r = 0; r < n; r++){
            int score = 0;
            for(int j = 0; j < n -1; j++){
                char c1 = s.charAt((r+j) %n);
                char c2 = s.charAt((r+j+1) % n);
                if(c1 == c2)score++;
                
            }
            if(score == k)ans++;
        }return ans;
    }
}
