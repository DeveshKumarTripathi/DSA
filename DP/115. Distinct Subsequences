class Solution {
    public int numDistinct(String s, String t) {
        int n = s.length();
        int m = t.length();
        long[][] dp = new long[n][m];

        for (long[] row : dp) {
            Arrays.fill(row, -1);
        }
        return (int)solve(n-1, m-1, s, t, dp);

    }
    public long solve(int i, int j, String s, String t, long[][] dp){
        if(j < 0)return 1;
        if(i < 0)return 0;

        if(dp[i][j] != -1)return dp[i][j];

        if(s.charAt(i) == t.charAt(j)){
            dp[i][j] = solve(i-1, j-1, s, t, dp) + solve(i-1, j, s, t, dp);
        }else{
            dp[i][j] = solve(i-1, j, s, t, dp);
        }
        return dp[i][j];
    }
}




