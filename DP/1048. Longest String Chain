class Solution {
    public int longestStrChain(String[] nums) {
        Arrays.sort(nums, (a, b) -> a.length() - b.length());
        int n = nums.length;

        int[] dp = new int[n];
        Arrays.fill(dp, 1);
        int max = 1;

        for(int i = 1; i < n; i++){
            for(int j = i-1; j >= 0; j--){
                if(nums[i].length() - nums[j].length() == 1 && isCheck(nums[i], nums[j])){
                    if(dp[j] + 1 > dp[i]){
                        dp[i] = dp[j] + 1;
                    }
                }
            }
            max = Math.max(max, dp[i]);

        }
        return max;
    }
    public boolean isCheck(String s1, String s2){
        int i = 0;
        int j = 0;

        while(i < s1.length()) {
            if(j < s2.length() && s1.charAt(i) == s2.charAt(j)) {
                i++;
                j++;
            }
            else {
                i++;
            }
        }
        if(j == s2.length())return true;
        else return false;
    }
}
