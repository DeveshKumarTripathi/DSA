import java.util.*;

class Solution {
    public int minCost(int[][] grid) {
        int m = grid.length;
        int n = grid[0].length;

        BitSet[][] dp = new BitSet[n][2];

        for (int j = 0; j < n; j++) {
            dp[j][0] = new BitSet(1024);
            dp[j][1] = new BitSet(1024);
        }

        dp[0][0].set(grid[0][0]);

        for (int i = 0; i < m; i++) {
            int curr = i % 2;
            int prev = 1 - curr;

            for (int j = 0; j < n; j++) {
                BitSet current = dp[j][curr];

                if (i == 0 && j == 0) {
                    continue;
                }

                BitSet next = new BitSet(1024);
                int val = grid[i][j];

                // Paths from above
                if (i > 0) {
                    BitSet above = dp[j][prev];

                    for (int x = above.nextSetBit(0);
                         x >= 0;
                         x = above.nextSetBit(x + 1)) {
                        next.set(x ^ val);
                    }
                }

                // Paths from the left
                if (j > 0) {
                    BitSet left = dp[j - 1][curr];

                    for (int x = left.nextSetBit(0);
                         x >= 0;
                         x = left.nextSetBit(x + 1)) {
                        next.set(x ^ val);
                    }
                }

                dp[j][curr] = next;
            }
        }

        BitSet result = dp[n - 1][(m - 1) % 2];

        return result.nextSetBit(0);
    }
}
