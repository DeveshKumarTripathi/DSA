class Solution {
    public int minimumSwaps(int[] nums) {
        int count = 0;

        for (int num : nums) {
            if (num == 0) {
                count++;
            }
        }
        int swaps = 0;

        for (int i = 0; i < nums.length - count; i++) {
            if (nums[i] == 0) {
                swaps++;
            }
        }
        return swaps;
    }
}
