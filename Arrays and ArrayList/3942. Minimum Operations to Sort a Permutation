
class Solution {
    public int minOperations(int[] nums) {
        int n = nums.length;

        if (n == 1) {
            return 0;
        }

        boolean increasing = true;
        boolean decreasing = true;

        for (int i = 0; i < n; i++) {
            if (nums[i] != (nums[0] + i) % n) {
                increasing = false;
            }

            if (nums[i] != (nums[0] - i + n) % n) {
                decreasing = false;
            }
        }

        int ans = Integer.MAX_VALUE;

        // Case 1: Cyclically increasing
        if (increasing) {
            int k = (n - nums[0]) % n;

            if (k == 0) {
                ans = 0;
            } else {
                ans = Math.min(k, n - k + 2);
            }
        }

        // Case 2: Cyclically decreasing
        if (decreasing) {
            int k = (n - nums[n - 1]) % n;
            ans = Math.min(ans, Math.min(k, n - k) + 1);
        }

        return ans == Integer.MAX_VALUE ? -1 : ans;
    }
}
