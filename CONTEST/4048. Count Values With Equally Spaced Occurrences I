class Solution {
    public int countSpecialIntegers(int[] nums) {
        int[] count = new int[101];
        int[] first = new int[101];
        int[] second = new int[101];
        boolean[] special = new boolean[101];

        for(int i = 0; i < nums.length; i++){
            int x = nums[i];

            if(count[x] == 0){
                first[x] = i;
            }else if(count[x] == 1){
                second[x] = i;
            }else if(count[x] == 2){
                special[x] = first[x] + i == 2 * second[x];
            }
            count[x]++;
        }
        int ans = 0;
        for(int x = 1; x <= 100; x++){
            if(count[x] == 3 && special[x]){
                ans++;
            }
        }
        return ans;
    }
}
