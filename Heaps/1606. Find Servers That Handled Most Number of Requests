
import java.util.*;

class Solution {
    public List<Integer> busiestServers(int k, int[] arrival, int[] load) {

        TreeSet<Integer> available = new TreeSet<>();

        // Initially, all servers are available
        for (int i = 0; i < k; i++) {
            available.add(i);
        }

        // Min Heap: {finishTime, serverId}
        PriorityQueue<int[]> busy = new PriorityQueue<>(
            (a, b) -> Integer.compare(a[0], b[0])
        );

        int[] count = new int[k];
        int maxRequests = 0;

        for (int i = 0; i < arrival.length; i++) {

            int currentTime = arrival[i];

            // Release servers whose requests are completed
            while (!busy.isEmpty() &&
                   busy.peek()[0] <= currentTime) {

                int[] server = busy.poll();
                available.add(server[1]);
            }

            // If no server is available, drop the request
            if (available.isEmpty()) {
                continue;
            }

            // Required server according to i % k
            int target = i % k;

            // Find the smallest available server >= target
            Integer serverId = available.ceiling(target);

            // If none exists, wrap around to the smallest
            if (serverId == null) {
                serverId = available.first();
            }

            // Assign the request
            available.remove(serverId);

            count[serverId]++;
            maxRequests = Math.max(maxRequests, count[serverId]);

            // Calculate finishing time
            int finishTime = currentTime + load[i];

            busy.offer(new int[]{finishTime, serverId});
        }

        // Collect all busiest servers
        List<Integer> result = new ArrayList<>();

        for (int i = 0; i < k; i++) {
            if (count[i] == maxRequests) {
                result.add(i);
            }
        }

        return result;
    }
}
