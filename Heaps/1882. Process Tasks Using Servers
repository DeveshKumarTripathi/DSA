
import java.util.*;

class Solution {
    public int[] assignTasks(int[] servers, int[] tasks) {

        int n = servers.length;
        int m = tasks.length;

        int[] ans = new int[m];

        // Free servers: weight, index
        PriorityQueue<int[]> freeServers = new PriorityQueue<>(
            (a, b) -> {
                if (a[0] != b[0]) {
                    return Integer.compare(a[0], b[0]);
                }
                return Integer.compare(a[1], b[1]);
            }
        );

        // Busy servers: finishTime, weight, index
        PriorityQueue<long[]> busyServers = new PriorityQueue<>(
            (a, b) -> {
                if (a[0] != b[0]) {
                    return Long.compare(a[0], b[0]);
                }
                if (a[1] != b[1]) {
                    return Long.compare(a[1], b[1]);
                }
                return Long.compare(a[2], b[2]);
            }
        );

        // Initially all servers are free
        for (int i = 0; i < n; i++) {
            freeServers.offer(new int[]{servers[i], i});
        }

        long currentTime = 0;

        for (int j = 0; j < m; j++) {

            // IMPORTANT: Time must never move backward
            currentTime = Math.max(currentTime, j);

            // Release all servers available at current time
            while (!busyServers.isEmpty()
                    && busyServers.peek()[0] <= currentTime) {

                long[] server = busyServers.poll();

                freeServers.offer(
                    new int[]{(int) server[1], (int) server[2]}
                );
            }

            // If no server is free, jump to earliest finish time
            if (freeServers.isEmpty()) {

                currentTime = busyServers.peek()[0];

                // Release all servers finishing at this time
                while (!busyServers.isEmpty()
                        && busyServers.peek()[0] <= currentTime) {

                    long[] server = busyServers.poll();

                    freeServers.offer(
                        new int[]{(int) server[1], (int) server[2]}
                    );
                }
            }

            // Select server with minimum weight and index
            int[] server = freeServers.poll();

            int weight = server[0];
            int index = server[1];

            ans[j] = index;

            // Server becomes free after processing this task
            long finishTime = currentTime + tasks[j];

            busyServers.offer(
                new long[]{finishTime, weight, index}
            );
        }

        return ans;
    }
}
