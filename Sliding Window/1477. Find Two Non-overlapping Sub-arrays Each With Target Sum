class Solution {
    public int minSumOfLengths(int[] arr, int target) {
        int n = arr.length;
        int INF = n + 1;
        int[] dp = new int[n];

        for (int i = 0; i < n; i++) dp[i] = INF;

        int l = 0, sum = 0, ans = INF, best = INF;

        for (int r = 0; r < n; r++) {
            sum += arr[r];

            while (sum > target) {
                sum -= arr[l++];
            }

            if (sum == target) {
                int len = r - l + 1;

                if (l > 0 && dp[l - 1] != INF)
                    ans = Math.min(ans, len + dp[l - 1]);

                best = Math.min(best, len);
            }

            dp[r] = best;
        }

        return ans == INF ? -1 : ans;
    }
}
