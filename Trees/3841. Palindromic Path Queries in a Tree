import java.util.*;

class Solution {
    public List<Boolean> palindromePath(int n, int[][] edges, String s,
                                        String[] queries) {

        List<Integer>[] adj = new ArrayList[n];

        for (int i = 0; i < n; i++) {
            adj[i] = new ArrayList<>();
        }

        for (int[] e : edges) {
            adj[e[0]].add(e[1]);
            adj[e[1]].add(e[0]);
        }

        int LOG = 1;
        while ((1 << LOG) <= n) {
            LOG++;
        }

        int[][] up = new int[LOG][n];
        int[] depth = new int[n];
        int[] tin = new int[n];
        int[] tout = new int[n];
        int[] parent = new int[n];
        int[] iter = new int[n];
        int[] prefix = new int[n];

        char[] chars = s.toCharArray();

        // Iterative DFS and Euler tour
        int[] stack = new int[n];
        int top = 0;
        int timer = 0;

        Arrays.fill(parent, -1);

        stack[top++] = 0;
        parent[0] = 0;
        prefix[0] = 1 << (chars[0] - 'a');
        tin[0] = timer++;

        while (top > 0) {
            int u = stack[top - 1];

            if (iter[u] < adj[u].size()) {
                int v = adj[u].get(iter[u]++);

                if (v == parent[u]) {
                    continue;
                }

                parent[v] = u;
                depth[v] = depth[u] + 1;
                prefix[v] = prefix[u] ^ (1 << (chars[v] - 'a'));

                tin[v] = timer++;
                stack[top++] = v;
            } else {
                tout[u] = timer - 1;
                top--;
            }
        }

        // Binary lifting for LCA
        for (int i = 0; i < n; i++) {
            up[0][i] = parent[i];
        }

        for (int k = 1; k < LOG; k++) {
            for (int i = 0; i < n; i++) {
                up[k][i] = up[k - 1][up[k - 1][i]];
            }
        }

        Fenwick bit = new Fenwick(n);
        List<Boolean> answer = new ArrayList<>();

        for (String q : queries) {
            String[] p = q.split(" ");

            if (p[0].equals("update")) {
                int u = Integer.parseInt(p[1]);
                char c = p[2].charAt(0);

                int oldMask = 1 << (chars[u] - 'a');
                int newMask = 1 << (c - 'a');
                int delta = oldMask ^ newMask;

                if (delta != 0) {
                    bit.update(tin[u] + 1, delta);
                    bit.update(tout[u] + 2, delta);
                    chars[u] = c;
                }

            } else {
                int u = Integer.parseInt(p[1]);
                int v = Integer.parseInt(p[2]);

                int pu = prefix[u] ^ bit.query(tin[u] + 1);
                int pv = prefix[v] ^ bit.query(tin[v] + 1);

                int lca = getLCA(u, v, depth, up, LOG);

                int mask = pu ^ pv ^ (1 << (chars[lca] - 'a'));

                answer.add((mask & (mask - 1)) == 0);
            }
        }

        return answer;
    }

    private int getLCA(int u, int v, int[] depth,
                       int[][] up, int LOG) {

        if (depth[u] < depth[v]) {
            int temp = u;
            u = v;
            v = temp;
        }

        int diff = depth[u] - depth[v];

        for (int k = 0; k < LOG; k++) {
            if ((diff & (1 << k)) != 0) {
                u = up[k][u];
            }
        }

        if (u == v) {
            return u;
        }

        for (int k = LOG - 1; k >= 0; k--) {
            if (up[k][u] != up[k][v]) {
                u = up[k][u];
                v = up[k][v];
            }
        }

        return up[0][u];
    }

    static class Fenwick {
        int[] tree;
        int n;

        Fenwick(int n) {
            this.n = n;
            tree = new int[n + 2];
        }

        void update(int i, int val) {
            while (i <= n + 1) {
                tree[i] ^= val;
                i += i & -i;
            }
        }

        int query(int i) {
            int ans = 0;

            while (i > 0) {
                ans ^= tree[i];
                i -= i & -i;
            }

            return ans;
        }
    }
}
